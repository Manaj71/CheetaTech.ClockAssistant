<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CheetaTech.ClockAssistant.App.MainPage"
    Title="ShiftPilot">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="560"
            HorizontalOptions="Center">

            <Label
                Text="ShiftPilot"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Current Shift"
                FontSize="20"
                FontAttributes="Bold" />

            <Border
                Padding="12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Clock In"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="ClockInStatusValue"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap" />
                    <Label
                        x:Name="ClockInTimeValue"
                        FontSize="12"
                        Opacity="0.8"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Clock Out"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="ClockOutStatusValue"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap" />
                    <Label
                        x:Name="ClockOutTimeValue"
                        FontSize="12"
                        Opacity="0.8"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="SummaryLabel"
                FontAttributes="Bold"
                LineBreakMode="WordWrap" />

            <Label
                x:Name="ResultLabel"
                IsVisible="False"
                LineBreakMode="WordWrap" />

            <Button
                x:Name="ActionButton"
                IsVisible="False"
                Text="Clock In" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
