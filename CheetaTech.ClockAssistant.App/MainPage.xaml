<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CheetaTech.ClockAssistant.App.MainPage"
    Title="Clock Assistant">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="560"
            HorizontalOptions="Center">

            <Label
                Text="CheetaTech Clock Assistant"
                FontSize="28"
                FontAttributes="Bold"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Status"
                FontSize="20"
                FontAttributes="Bold"
                SemanticProperties.HeadingLevel="Level2" />

            <Border
                Padding="12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Configuration is available."
                        FontAttributes="Bold" />
                    <Label
                        Text="This is the normal Main/status foundation. Attendance state, next scheduled action, notifications, history, and Advanced status will be added in their dedicated phases."
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
